# ═════════════════════════════════════════════════════════════
# ErgoTopLab — variables de entorno
# 1. Copia este archivo a `.env.local` (desarrollo) y rellena los valores.
# 2. En producción, crea las MISMAS variables en Vercel → Settings → Environment Variables.
# 3. Comprueba qué falta en cualquier momento con:  npm run env:check
# ═════════════════════════════════════════════════════════════

# ── 1. Amazon Afiliados (sin PA-API) ─────────────────────────
# Tags de Amazon Afiliados (Associates Central → "Gestionar ID de seguimiento").
# Si se dejan vacías se usan estos mismos valores por defecto.
AMAZON_AFFILIATE_TAG_ES="ergotoplab-21"
AMAZON_AFFILIATE_TAG_US="ergotoplabus-20"

# ── 2. Seguridad de los webhooks (n8n / Make) ────────────────
# Clave que n8n envía en la cabecera `x-api-key`. Mínimo 24 caracteres.
# Genera una con:  openssl rand -hex 32
# ⚠ El valor de ejemplo se rechaza: la API responde 503 hasta que pongas una clave real.
API_SECRET_KEY="crea_una_clave_secreta_segura_aqui"

# ── 3. Base de datos Neon PostgreSQL (donde se guardan los productos) ─
# Neon Console → tu proyecto → botón "Connect" → copia la cadena con
# "Connection pooling" ACTIVADO (host con "-pooler"). Debe incluir ?sslmode=require.
# Sin esta variable la web funciona en modo demo (solo lectura) y la API devuelve 503.
DATABASE_URL="postgresql://neondb_owner:TU_PASSWORD@ep-xxxx-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Recomendada para `npm run db:migrate`: la misma cadena con "Connection pooling"
# DESACTIVADO (host sin "-pooler"). Si se deja vacía se usa DATABASE_URL.
DATABASE_MIGRATION_URL=

# Solo desarrollo local sin cuenta de Neon (ver README → "Desarrollo local"):
# NEON_LOCAL_WS_PROXY=localhost:5488/v1

# ── 4. Sitio ─────────────────────────────────────────────────
# FASE DE PRUEBAS (Vercel Free Tier, sin dominio propio): usa el dominio .vercel.app
# que te asigne Vercel (Project → Settings → Domains). Si lo dejas vacío en Vercel, se
# detecta solo con NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL.
# Al conectar el dominio definitivo cámbiala a: https://ergotoplab.com
NEXT_PUBLIC_SITE_URL="https://ergotoplab.vercel.app"
NEXT_PUBLIC_SITE_NAME="ErgoTopLab"
# Opcional: "true" para que Google no indexe el dominio temporal durante las pruebas
NEXT_PUBLIC_SITE_NOINDEX="false"

# ── 5. Google (opcionales hasta tener las cuentas) ───────────
# GA4: Administrar → Flujos de datos → ID de medición (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
# Opcional: Google Tag Manager (GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=
# AdSense: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# IDs de los bloques de anuncio creados en AdSense
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_DISPLAY=
