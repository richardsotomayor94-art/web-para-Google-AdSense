# ─────────────────────────────────────────────────────────────
# ErgoHack — variables de entorno
# Copia este archivo a `.env.local` y rellena los valores.
# ─────────────────────────────────────────────────────────────

# URL pública canónica del sitio (sin barra final). Se usa en sitemap, JSON-LD, OG y llms.txt
NEXT_PUBLIC_SITE_URL=https://www.ergohack.es

# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Solo servidor. Nunca la expongas en el cliente.
SUPABASE_SERVICE_ROLE_KEY=
# Cadena de conexión Postgres que usa Drizzle ORM.
# En Supabase: Project Settings → Database → Connection string → "Transaction pooler" (puerto 6543).
# Si se deja vacía, la web funciona en modo demo con datos de ejemplo (solo lectura).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# ── Amazon Afiliados ─────────────────────────────────────────
AMAZON_AFFILIATE_TAG_ES=ergohack-21
AMAZON_AFFILIATE_TAG_US=ergohack-20

# ── Google ───────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Opcional: si usas Tag Manager además de (o en lugar de) GA4
NEXT_PUBLIC_GTM_ID=
# Formato ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
# IDs de bloques de anuncio creados en AdSense (opcionales; si faltan se usa un placeholder en desarrollo)
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_DISPLAY=

# ── API interna (webhooks n8n / Make) ────────────────────────
# Genera una clave larga: openssl rand -hex 32
API_SECRET_KEY=
